APP_ENV=development
LOG_LEVEL=INFO
# Leave blank for local SQLite. Production may use libsql://... from Turso.
DATABASE_URL=
TURSO_AUTH_TOKEN=
DATA_DB_PATH=./opportunity_sentinel.db
CHECKPOINT_DB_PATH=./opportunity_checkpoints.sqlite
MAX_RESEARCH_ATTEMPTS=2
MIN_VERIFICATION_SCORE=0.80
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
GROQ_API_KEY=
OPENROUTER_API_KEY=
TAVILY_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_MODEL=openrouter/free
# Models for the agentic pipeline. These must support native tool calling and
# json_schema responses, which the batch collector's models do not guarantee.
AGENT_GROQ_MODEL=openai/gpt-oss-120b
AGENT_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
MEMORY_DB_PATH=./student_memory.sqlite
KNOWLEDGE_DIR=./docs/knowledge
RAG_TOP_K=4
# LangSmith tracing. Free tier at https://smith.langchain.com — every workflow run,
# task, retry and LLM call shows up as a trace under LANGCHAIN_PROJECT.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=nabaa-capstone
SEARCH_MAX_RESULTS=5
REQUEST_TIMEOUT_SECONDS=20
NOTIFICATION_INTERVAL_MINUTES=480
OFFICIAL_SCAN_INTERVAL_MINUTES=30
REVALIDATION_INTERVAL_HOURS=24
REVALIDATION_BATCH_SIZE=30
DISCOVERY_CYCLE_TIMEOUT_SECONDS=150
SEARCH_HEARTBEAT_HOURS=24
PUBLIC_BASE_URL=
TELEGRAM_WEBHOOK_SECRET=
INTERNAL_API_SECRET=
TAVILY_MONTHLY_CREDIT_LIMIT=900
DIGEST_HOUR_RIYADH=18
DELIVERY_BATCH_SIZE=10
